---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <meta property="og:url" content="haberkiran.github.io" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="kiran haber" />
    <meta property="og:description" content="Kiran Haber :: Computer Engineering @ UCSB. Here's what I'm building, doing, taking photos of, and everything else." />
    <meta name="twitter:card" content="summary" />
	</head>
	<body>
		<Sidebar />
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	main {
		flex: 1;
		height: 100vh;
		overflow-y: auto;
		position: relative;
	}

	@media (max-width: 768px) {
		main {
			height: auto;
			overflow-y: visible;
		}
	}
</style>

---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';

import discoBall from '../photos/000000020002.jpg';
import nightLights from '../photos/000000020010.jpg';
import pipeHouse from '../photos/000000020012.jpg';
import tustin from '../photos/IMG_0109.jpg';
import aquarium from '../photos/000000010029.jpg';
import whitetree from '../photos/000000020006.jpg';
import rose from '../photos/000000020016.jpg';
import de_seagull from '../photos/000000030027.jpg'

const photos = [
  { src: discoBall, name: 'boulevard, ca' },
  { src: nightLights, name: 'boulevard, ca' },
  { src: pipeHouse, name: 'boulevard, ca' },
  { src: tustin, name: 'tustin, ca' },
  { src: aquarium, name: 'san diego, ca' },
  { src: whitetree, name: 'san diego, ca' },
  { src: rose, name: 'san diego, ca' },
  { src: de_seagull, name: 'san diego, ca' },
];
---

<Base title="kiran haber :: photography">
  <div class="photo-grid">
    {photos.map(photo => (
      <div class="photo-item">
        <a href={photo.src.src} target="_blank">
          <Image src={photo.src} alt={photo.name} width={600} loading="eager" />
          <div class="filename meta">{photo.name}</div>
        </a>
      </div>
    ))}
  </div>
</Base>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 4px;
    padding: 4px;
  }

  .photo-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #a0a4a8;
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .filename {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(178, 182, 186, 0.8);
    padding: 2px 4px;
    opacity: 0;
    transition: opacity 0.1s ease-in-out;
    pointer-events: none;
    font-family: 'Iosevka', monospace;
  }

  .photo-item:hover .filename {
    opacity: 1;
  }
</style>

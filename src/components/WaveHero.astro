---
---
<div id="hero-container"></div>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('hero-container');
  if (!container) throw new Error('Hero container not found');

  const scene = new THREE.Scene();
  scene.background = new THREE.Color('#b2b6ba');

  const width = container.clientWidth || window.innerWidth - 152;
  const height = container.clientHeight || window.innerHeight;
  const aspect = width / height;

  // Isometric-ish camera
  const d = 100;
  const camera = new THREE.OrthographicCamera(-d * aspect, d * aspect, d, -d, 1, 1000);
  camera.position.set(200, 200, 200);
  camera.lookAt(scene.position);

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(width, height);
  container.appendChild(renderer.domElement);

  // Geometry - Square grid
  const geometry = new THREE.PlaneGeometry(200, 200, 20, 20);
  geometry.rotateX(Math.PI / 1.35);
  geometry.rotateY(Math.PI / 14);
  geometry.rotateZ(Math.PI / 3);


  const uniforms = {
    uTime: { value: 0 },
    uJitter: { value: 120.0 },
  };

  // Custom Shader Material - Sinusoidal movement with PS1 Jitter
  const material = new THREE.ShaderMaterial({
    uniforms: uniforms,
    vertexShader: `
      uniform float uTime;
      uniform float uJitter;
      varying vec2 vUv;
      void main() {
        vUv = uv;
        
        // 1. World-space snapping (chunky 3D steps)
        vec3 pos = position;
        float snapRes = 8.0;
        pos = floor(pos / snapRes + 0.5) * snapRes;

        vec4 worldPos = modelMatrix * vec4(pos, 1.0);
        
        // 2. Wave logic
        float wave = sin((pos.x + pos.y) * 0.05 - uTime * 2.5) * 12.0;
        worldPos.y += wave;
        
        // 3. Project to Clip Space
        vec4 clipPos = projectionMatrix * viewMatrix * worldPos;

        // 4. PS1 Screen-space Jitter (shaky polygon edges)
        clipPos.xy = floor(clipPos.xy * uJitter + 0.5) / uJitter;
        
        gl_Position = clipPos;
      }
    `,
    fragmentShader: `
      varying vec2 vUv;
      void main() {
        gl_FragColor = vec4(0.0, 0.0, 0.39, 0.15); // Very transparent blue
      }
    `,
    transparent: true,
    side: THREE.DoubleSide,
  });

  // Group everything so they rotate together
  const gridGroup = new THREE.Group();
  scene.add(gridGroup);

  const mesh = new THREE.Mesh(geometry, material);
  gridGroup.add(mesh);

  // Wireframe - The "Grid" lines
  const wireframeMaterial = new THREE.ShaderMaterial({
    uniforms: uniforms,
    vertexShader: material.vertexShader,
    fragmentShader: `
      void main() {
        gl_FragColor = vec4(0.0, 0.0, 0.93, 0.4); // Brighter blue lines
      }
    `,
    wireframe: true,
    transparent: true,
  });
  const meshWireframe = new THREE.Mesh(geometry, wireframeMaterial);
  gridGroup.add(meshWireframe);

  // Nodes (Points) - Intersection dots
  const pointsMaterial = new THREE.ShaderMaterial({
    uniforms: uniforms,
    vertexShader: `
      uniform float uTime;
      uniform float uJitter;
      void main() {
        // 1. World-space snapping
        vec3 pos = position;
        float snapRes = 8.0;
        pos = floor(pos / snapRes + 0.5) * snapRes;

        vec4 worldPos = modelMatrix * vec4(pos, 1.0);
        
        // 2. Wave logic
        float wave = sin((pos.x + pos.y) * 0.05 - uTime * 2.5) * 12.0;
        worldPos.y += wave;
        
        // 3. Project and Jitter
        vec4 clipPos = projectionMatrix * viewMatrix * worldPos;
        clipPos.xy = floor(clipPos.xy * uJitter + 0.5) / uJitter;
        
        gl_PointSize = 2.0;
        gl_Position = clipPos;
      }
    `,
    fragmentShader: `
      void main() {
        gl_FragColor = vec4(0.0, 0.0, 0.93, 0.6);
      }
    `,
    transparent: true,
  });
  const points = new THREE.Points(geometry, pointsMaterial);
  gridGroup.add(points);

  // Initial Isometric Rotation on the GROUP
  gridGroup.rotation.z = -Math.PI / 4; // 45 deg
  gridGroup.rotation.x = -Math.PI / 3.5; // Tilt

  function animate() {
    requestAnimationFrame(animate);
    uniforms.uTime.value += 0.006;
    renderer.render(scene, camera);
  }

  animate();

  window.addEventListener('resize', () => {
    const w = container.clientWidth || window.innerWidth - 152;
    const h = container.clientHeight || window.innerHeight;
    renderer.setSize(w, h);
    const aspect = w / h;
    camera.left = -d * aspect;
    camera.right = d * aspect;
    camera.top = d;
    camera.bottom = -d;
    camera.updateProjectionMatrix();
  });
</script>

<style>
  #hero-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
</style>
